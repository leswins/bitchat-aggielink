    "board.accessibility.post": {
      "comment": "Accessibility label for the board post button",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Post notice"
          }
        }
      }
    },
    "board.accessibility.post_row": {
      "comment": "Accessibility label for a board post row",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notice from %@: %@"
          }
        }
      }
    },
    "board.action.delete": {
