    "command.group.usage": {
      "comment": "Usage hint for /group subcommands",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "usage: /group create <name> · invite @name · remove @name · leave · list"
          }
        }
      }
    },
    "command.help.text": {
      "comment": "The /help reference list; command syntax stays verbatim, only the descriptions after each dash are translated",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "commands:\n/msg @name [message] — start a private chat\n/who — list who's here\n/clear — clear this chat\n/hug @name — send a hug\n/slap @name — slap with a large trout\n/block @name · /unblock @name\n/fav @name · /unfav @name — favorites\n/group create <name> — start an encrypted group\n/group invite @name · /group remove @name — manage members (creator)\n/group leave · /group list — leave or list your groups\n/ping @name — measure round-trip time\n/trace @name — estimated mesh path\n/help — this list"
          }
        }
      }
    },
    "command.msg.not_found": {
      "comment": "Error when /msg can't resolve the nickname",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' not found"
          }
        }
      }
    },
    "command.msg.started": {
      "comment": "Confirmation after /msg opens a private chat",
      "extractionState": "manual",
      "localizations": {
