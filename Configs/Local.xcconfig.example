// Your Apple Developer Team ID - https://stackoverflow.com/a/18727947
DEVELOPMENT_TEAM = ABC123

// Unique bundle id to be able to register and run locally beside TestFlight.
PRODUCT_BUNDLE_IDENTIFIER = com.aggielink.ios.$(DEVELOPMENT_TEAM)

// App and share extension must use an App Group registered to your team.
APP_GROUP_ID = group.com.aggielink.ios.$(DEVELOPMENT_TEAM)
