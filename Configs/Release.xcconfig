MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

IPHONEOS_DEPLOYMENT_TARGET = 16.0
MACOSX_DEPLOYMENT_TARGET = 13.0
SWIFT_VERSION = 5.0

// Founder: set DEVELOPMENT_TEAM to the Aggie Link Apple Developer Team ID
// before the first archive. Debug builds can still override it in
// Configs/Local.xcconfig. Archive/TestFlight reads this file only.
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

PRODUCT_BUNDLE_IDENTIFIER = com.aggielink.ios
APP_GROUP_ID = group.com.aggielink.ios
